#!/usr/bin/env python3
"""term - ask Gemini a question from any terminal.

Usage:
    term what is the capital of France
    term -c what is the capital of France     (pip-install-style output)
    echo "some text" | term summarize this
"""
import json
import os
import re
import ssl
import sys
import time
import urllib.error
import urllib.request

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
DEFAULT_MODEL = "gemini-2.5-flash"
BAR_WIDTH = 40


def load_env(path):
    if not os.path.exists(path):
        return
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            value = value.strip().strip('"').strip("'")
            os.environ.setdefault(key.strip(), value)


def ssl_context():
    # python.org builds on macOS often ship without CA certs; fall back gracefully.
    try:
        import certifi
        return ssl.create_default_context(cafile=certifi.where())
    except ImportError:
        pass
    if os.path.exists("/etc/ssl/cert.pem"):
        return ssl.create_default_context(cafile="/etc/ssl/cert.pem")
    return ssl.create_default_context()


def stream_text(req):
    with urllib.request.urlopen(req, context=ssl_context()) as resp:
        for raw in resp:
            line = raw.decode("utf-8").strip()
            if not line.startswith("data:"):
                continue
            chunk = json.loads(line[5:])
            for cand in chunk.get("candidates", []):
                for part in cand.get("content", {}).get("parts", []):
                    text = part.get("text", "")
                    if text:
                        yield text


def fmt_size(n):
    return "%.1f kB" % (n / 1000.0) if n < 1000000 else "%.1f MB" % (n / 1000000.0)


def strip_markdown(line):
    line = re.sub(r"^\s*#+\s*", "", line)
    line = re.sub(r"\*\*(.+?)\*\*", r"\1", line)
    line = re.sub(r"`{1,3}", "", line)
    return line


def render_pip_style(chunks, model):
    color = sys.stdout.isatty()

    def c(code, text):
        return "\033[%sm%s\033[0m" % (code, text) if color else text

    out = sys.stdout
    out.write("Collecting answer\n")
    termVar = 'pythonifiy'
    out.write("  Using cached %s-py3-none-any.whl.metadata (2.1 kB)\n" % termVar)
    out.flush()

    parts = []
    received = 0
    start = time.time()
    bar_open = False

    def draw(done):
        elapsed = max(time.time() - start, 1e-3)
        speed = received / elapsed / 1000000.0
        size = fmt_size(received)
        bar = c("38;5;70" if done else "38;5;197", "━" * BAR_WIDTH)
        out.write("%s     %s %s %s %s" % (
            "\r" if color else "",
            bar,
            c("32", "%s/%s" % (size, size)),
            c("31", "%.1f MB/s" % speed),
            c("36", "eta 0:00:00"),
        ))
        out.flush()

    try:
        for text in chunks:
            if not bar_open:
                out.write("  Downloading response\n")
                bar_open = True
            parts.append(text)
            received += len(text.encode("utf-8"))
            if color:
                draw(False)
        if bar_open:
            draw(True)
            out.write("\n")
            bar_open = False
    finally:
        if bar_open:
            out.write("\n")
            out.flush()

    out.write("Installing collected packages: answer\n")
    for line in "".join(parts).strip().splitlines():
        out.write("  %s\n" % c("2", strip_markdown(line)))
    out.write("Successfully installed answer-1.0\n")
    out.flush()


def main():
    load_env(os.path.join(SCRIPT_DIR, ".env"))

    api_key = os.environ.get("GEMINI_API_KEY", "")
    if not api_key:
        sys.exit("term: GEMINI_API_KEY is not set. Add it to %s" % os.path.join(SCRIPT_DIR, ".env"))
    model = os.environ.get("GEMINI_MODEL") or DEFAULT_MODEL

    args = sys.argv[1:]
    code_mode = bool(args) and args[0] in ("-c", "--code")
    if code_mode:
        args = args[1:]

    question = " ".join(args).strip()
    if not sys.stdin.isatty():
        piped = sys.stdin.read().strip()
        if piped:
            question = (question + "\n\n" + piped).strip()
    if not question:
        sys.exit("usage: term [-c] <your question>")

    system = ("You are a helpful assistant answering questions in a terminal. "
              "Be concise. Use plain text; avoid heavy markdown.")
    if code_mode:
        system += " Respond in plain text only, with no markdown formatting."

    body = json.dumps({
        "systemInstruction": {"parts": [{"text": system}]},
        "contents": [{"role": "user", "parts": [{"text": question}]}],
    }).encode()

    url = ("https://generativelanguage.googleapis.com/v1beta/models/%s:streamGenerateContent?alt=sse"
           % model)
    req = urllib.request.Request(url, data=body, headers={
        "Content-Type": "application/json",
        "x-goog-api-key": api_key,
    })

    try:
        if code_mode:
            render_pip_style(stream_text(req), model)
        else:
            for text in stream_text(req):
                sys.stdout.write(text)
                sys.stdout.flush()
            print()
    except urllib.error.HTTPError as e:
        detail = e.read().decode("utf-8", "replace")
        try:
            detail = json.loads(detail)["error"]["message"]
        except (ValueError, KeyError, TypeError):
            pass
        sys.exit("term: Gemini API error %s: %s" % (e.code, detail))
    except urllib.error.URLError as e:
        sys.exit("term: network error: %s" % e.reason)
    except KeyboardInterrupt:
        print()
        sys.exit(130)


if __name__ == "__main__":
    main()
